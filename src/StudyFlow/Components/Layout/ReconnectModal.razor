<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" aria-label="Connection status" data-nosnippet>
    <div class="components-reconnect-container">
        <p class="components-reconnect-first-attempt-visible">
            Reconnecting…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">
            Couldn’t reconnect. Check your connection and try again.
        </p>
        <button type="button" id="components-reconnect-button" class="button primary components-reconnect-failed-visible">
            Retry
        </button>
        <p class="components-pause-visible">
            Your session paused.
        </p>
        <p class="components-resume-failed-visible">
            Couldn’t resume. Try again or reload the page.
        </p>
        <button type="button" id="components-resume-button" class="button primary components-pause-visible components-resume-failed-visible">
            Resume
        </button>
    </div>
</dialog>
